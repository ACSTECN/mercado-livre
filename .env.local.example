# Supabase (opcional - MVP funciona 100% local sem banco)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# OCR Provider (opcional)
# Valores: tesseract | google | azure
NEXT_PUBLIC_OCR_PROVIDER=tesseract

# Se usar Google Vision API (apenas server-side, não exponha no client!)
# GOOGLE_VISION_API_KEY=your-key
